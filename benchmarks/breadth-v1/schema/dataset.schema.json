{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "breadth-v1 private held-out dataset",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {"const": "breadth-v1"},
    "items": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "rubric", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^(SEC|ARC|OPS)-[0-9]{2}$"},
          "category": {"enum": ["security", "architecture-risk", "operational-failure-mode"]},
          "prompt": {"type": "string", "minLength": 30},
          "rubric": {
            "type": "object", "required": ["atomic_findings", "high_severity_ids", "source_ids"],
            "properties": {
              "atomic_findings": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 12}},
              "high_severity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "url", "kind"]}}
        }
      }
    }
  }
}
